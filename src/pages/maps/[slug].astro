---
import Layout from '../../components/Layout.astro';
import maps from '../../data/maps.json';

export function getStaticPaths() {
  return maps.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const issueUrl =
  'https://github.com/tomekdot/trackmania-galaxy/issues/new?template=map-record.yml&labels=map-record&title=' +
  encodeURIComponent(`[Map] ${m.name}`);
const historyUrl =
  'https://github.com/tomekdot/trackmania-galaxy/issues/new?template=map-history.yml&labels=map-history&title=' +
  encodeURIComponent(`[Map history] ${m.name}`);
const editUrl = 'https://github.com/tomekdot/trackmania-galaxy/edit/main/src/data/maps.json';
const events = m.events || [];
const memories = m.memories || [];
const fullStars = Math.round(m.stars_avg || 0);
const starRow = '★'.repeat(fullStars) + '☆'.repeat(Math.max(0, 5 - fullStars));

// Mode-aware copy — grounded in the actual Galaxy game modes, not generic filler.
const MODES = {
  'Pursuit': {
    tagline: 'Cops vs thieves — survive the longest, capture thieves, rack up assists.',
    aboutHint: 'No description yet. Add the spawn & podium layout, the zones used (OffZone, Danger, Police, Thief, Speedbomb), available vehicles, escape routes and camping spots.',
    recordHint: 'No records yet. Be the first to submit a survival time, capture count or assist score — a replay or clip link makes it verifiable.',
  },
  'Goal Hunt': {
    tagline: 'Checkpoint hunting — reach the targets first, highest score wins the map.',
    aboutHint: 'No description yet. Add the checkpoint layout, arena flow, target routes, respawn points and the fastest lines between goals.',
    recordHint: 'No records yet. Be the first to submit a score or goals-reached run — a replay or clip link makes it verifiable.',
  },
  'Hunters': {
    tagline: 'Everyone chases everyone — catch your target, avoid being caught.',
    aboutHint: 'No description yet. Add the arena size, target spawn points, chase routes and hiding spots.',
    recordHint: 'No records yet. Be the first to submit a catch count or points run — a replay or clip link makes it verifiable.',
  },
};
const fallbackCopy = {
  tagline: 'A Trackmania Galaxy map — layout, routes and community records.',
  aboutHint: 'No description yet. Add layout notes, routes, surface types, zones and tactics.',
  recordHint: 'No records yet. Be the first to submit a time — a replay or clip link makes it verifiable.',
};
const mc = MODES[m.mode] || fallbackCopy;

const mapJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: m.name,
  headline: `${m.name} — ${m.mode || 'Trackmania'} map`,
  url: new URL(`${base}/maps/${m.slug}/`, Astro.site).href,
  image: m.thumbnail,
  genre: m.mode || 'Trackmania',
  ...(m.mapper ? { creator: { '@type': 'Person', name: m.mapper } } : {}),
  isPartOf: { '@type': 'WebSite', name: 'Trackmania Galaxy', url: new URL(`${base}/`, Astro.site).href },
  ...(m.stars_avg != null
    ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: m.stars_avg, bestRating: 5, ratingCount: m.stars_total || 1 } }
    : {}),
};
---
<Layout title={`${m.name} — Trackmania Galaxy`} description={`${m.name} by ${m.mapper} — ${m.mode} map in ${m.environment}. Records, screenshots, history and community memories.`} image={m.thumbnail} jsonLd={mapJsonLd}>
  <a class="back" href={`${base}/`}>← All maps</a>

  <div class="map-hero">
    <div class="hero-thumb">
      <img src={`${base}/thumbs/${m.slug}.webp`} alt={`${m.name} thumbnail`} width="512" height="512" fetchpriority="high" decoding="sync" data-fallback={m.thumbnail} />
    </div>
    <div class="hero-info">
      <h1>{m.name}</h1>
      <div class="badges">
        <span class="badge">{m.mode || 'map'}</span>
        <span class="badge env">{m.environment}</span>
        {m.map_type && <span class="badge">{m.map_type}</span>}
        {m.titlepack && <span class="badge env">{m.titlepack}</span>}
      </div>
      <p class="mode-tagline">{mc.tagline}</p>
      <dl class="facts">
        <dt>Mapper</dt><dd>{m.mapper || 'unknown'}</dd>
        {m.uploaded && (<><dt>Uploaded</dt><dd>{m.uploaded}</dd></>)}
        {m.mx_url && (<><dt>ManiaExchange</dt><dd><a href={m.mx_url} target="_blank" rel="noopener">#{m.mx_id}</a></dd></>)}
        {m.stars_avg != null && (
          <>
            <dt>Community rating</dt>
            <dd><span class="rating-big">{starRow}</span> {m.stars_avg.toFixed(1)}/5 ({m.stars_total} votes)</dd>
          </>
        )}
        {m.yn_rating != null && (
          <>
            <dt>YES/NO rating</dt>
            <dd>{m.yn_rating}/5 ({m.yn_votes} votes)</dd>
          </>
        )}
      </dl>
      <div class="cta">
        {m.mx_url && <a class="btn primary" href={m.mx_url} target="_blank" rel="noopener">View on ManiaExchange</a>}
        <a class="btn" href={issueUrl} target="_blank" rel="noopener">Submit record / screenshot</a>
        <a class="btn" href={historyUrl} target="_blank" rel="noopener">Submit history / memory</a>
        <a class="btn ghost" href={editUrl} target="_blank" rel="noopener">Edit on GitHub</a>
      </div>
    </div>
  </div>

  <section class="panel">
    <h2>About the map</h2>
    <p class="muted">{mc.aboutHint}</p>
  </section>

  <section class="panel">
    <h2>Screenshots</h2>
    {m.screenshots.length > 0 ? (
      <div class="shot-grid">
        {m.screenshots.map((s) => (
          <figure class="shot">
            <button class="shot-btn" type="button" data-full={s.url} data-caption={`${s.caption || m.name}${s.author ? ' — ' + s.author : ''}`} aria-label={`Enlarge screenshot: ${s.caption || m.name}`}>
              <img src={s.url} alt={s.caption || m.name} loading="lazy" />
            </button>
            <figcaption>{s.caption}{s.author ? ` — ${s.author}` : ''}{s.date ? ` (${s.date})` : ''}</figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <>
        <div class="shot-grid">
          <a class="shot-placeholder" href={issueUrl} target="_blank" rel="noopener" aria-label="Add your screenshot">
            <svg class="ph-icon" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="1.5" />
              <circle cx="8.5" cy="9.5" r="1.8" />
              <path d="M3.5 17.5l5-5 4 4 3-3 5 5" />
            </svg>
            <span class="ph-title">Screenshot preview</span>
            <span class="ph-sub">Your screenshot will appear here — click to add yours</span>
          </a>
        </div>
        <p class="muted">No screenshots yet. A link to an image is enough — it shows up as a thumbnail you can click to enlarge.</p>
      </>
    )}
  </section>

  <section class="panel">
    <h2>Record history</h2>
    {m.records.length > 0 ? (
      <table>
        <thead>
          <tr><th>Player</th><th>Time</th><th>Date</th><th>Replay</th><th>Clip</th><th>Note</th></tr>
        </thead>
        <tbody>
          {m.records.map((r) => (
            <tr>
              <td>{r.player}</td>
              <td><code>{r.time}</code></td>
              <td>{r.date}</td>
              <td>{r.replay ? <a href={r.replay} target="_blank" rel="noopener">replay</a> : '—'}</td>
              <td>{r.clip ? <a href={r.clip} target="_blank" rel="noopener">clip</a> : '—'}</td>
              <td>{r.note || ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="muted">{mc.recordHint}</p>
    )}
  </section>

  <section class="panel">
    <h2>Map history</h2>
    {events.length > 0 ? (
      <ol class="timeline">
        {events.map((e) => (
          <li>
            <span class="tl-date">{e.date}</span>
            <span class="tl-text">{e.text}{e.author ? <em> — {e.author}</em> : null}{e.link ? <> · <a href={e.link} target="_blank" rel="noopener">link</a></> : null}</span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="muted">No history yet. Submit a timestamped note about what happened on this map — a match, a record, a community event.</p>
    )}
  </section>

  <section class="panel">
    <h2>Memories</h2>
    {memories.length > 0 ? (
      <div class="memories">
        {memories.map((mem) => (
          <blockquote class="memory">
            <p>{mem.text}</p>
            <div class="mem-meta">{mem.author ? `— ${mem.author}` : ''}{mem.date ? ` (${mem.date})` : ''}{mem.url ? <> · <a href={mem.url} target="_blank" rel="noopener">link</a></> : null}</div>
          </blockquote>
        ))}
      </div>
    ) : (
      <p class="muted">No memories yet. Share a story, screenshot or meme from this map — what happened, and who was there.</p>
    )}
  </section>

  <div id="lightbox" class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Screenshot preview">
    <button class="lb-close" type="button" aria-label="Close preview">×</button>
    <img class="lb-img" src="" alt="" />
    <p class="lb-caption"></p>
  </div>

  <script is:inline>
    (function () {
      var lb = document.getElementById('lightbox');
      if (!lb) return;
      var img = lb.querySelector('.lb-img');
      var cap = lb.querySelector('.lb-caption');
      function open(src, caption) {
        img.src = src; img.alt = caption || '';
        cap.textContent = caption || '';
        lb.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function close() {
        lb.hidden = true; img.src = '';
        document.body.style.overflow = '';
      }
      document.querySelectorAll('.shot-btn').forEach(function (b) {
        b.addEventListener('click', function () { open(b.dataset.full, b.dataset.caption); });
      });
      lb.addEventListener('click', function (e) {
        if (e.target === lb || e.target.classList.contains('lb-close')) close();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !lb.hidden) close();
      });
    })();
  </script>
</Layout>
